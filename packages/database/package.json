{
  "name": "@sdlc/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev && pnpm run invariants",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy && pnpm run invariants",
    "push": "dotenv -e ../../.env -- prisma db push && pnpm run invariants",
    "validate": "dotenv -e ../../.env -- prisma validate",
    "format": "prisma format",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- tsx src/seed.ts",
    "build": "tsc -b",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist .turbo",
    "invariants": "dotenv -e ../../.env -- prisma db execute --file ./prisma/sql/invariants.sql --schema ./prisma/schema.prisma"
  },
  "dependencies": {
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "rimraf": "^6.0.1",
    "dotenv-cli": "^8.0.0"
  }
}
