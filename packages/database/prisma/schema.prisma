// AI-Native Software Delivery Organization — data model
// See docs/02-data-model.md. PostgreSQL is the SOURCE OF TRUTH; Temporal holds control flow only.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector, pg_trgm, uuidOssp(map: "uuid-ossp")]
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 1 — Identity & Project
// ═══════════════════════════════════════════════════════════════════════════

enum UserRole {
  ADMIN
  PRODUCT
  ARCHITECT
  ENGINEER
  QA
  VIEWER
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      UserRole @default(VIEWER)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships       ProjectMember[]
  approvalDecisions ApprovalDecision[]
  approvedArtifacts ArtifactVersion[]  @relation("ArtifactApprover")
  approvedAdrs      Adr[]              @relation("AdrApprover")
  codeReviews       CodeReview[]
  settingsUpdated   Setting[]

  @@map("users")
}

model ProjectMember {
  id        String   @id @default(uuid())
  projectId String
  userId    String
  role      UserRole
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  ARCHIVED
  COMPLETED
}

enum ProjectPhase {
  DISCOVERY
  REQUIREMENTS
  BACKLOG_DRAFT
  BACKLOG_REVIEW
  BACKLOG_APPROVED
  ARCHITECTURE
  ARCHITECTURE_APPROVED
  ESTIMATION
  PLANNING
  READY_FOR_DEVELOPMENT
  IN_DEVELOPMENT
  IN_QA
  RELEASE
  COMPLETED
  BLOCKED
  HUMAN_INTERVENTION_REQUIRED
}

model Project {
  id          String        @id @default(uuid())
  key         String        @unique // 'CMS' — used in workflow ids and story refs
  name        String
  description String?
  status      ProjectStatus @default(ACTIVE)
  phase       ProjectPhase  @default(DISCOVERY)
  settings    Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members         ProjectMember[]
  repositories    ProjectRepository[]
  integrations    ProjectIntegration[]
  documents       SourceDocument[]
  productVision   ProductVision?
  businessGoals   BusinessGoal[]
  stakeholders    Stakeholder[]
  requirements    Requirement[]
  businessRules   BusinessRule[]
  constraints     Constraint[]
  assumptions     Assumption[]
  openQuestions   OpenQuestion[]
  productDecisions ProductDecision[]
  risks           Risk[]
  epics           Epic[]
  stories         Story[]
  architectureOptions ArchitectureOption[]
  architectureRecommendations ArchitectureRecommendation[]
  adrs            Adr[]
  estimates       Estimate[]
  estimateReviews EstimateReview[]
  resourcePlans   ResourcePlan[]
  deliveryPlans   DeliveryPlan[]
  branches        Branch[]
  pullRequests    PullRequest[]
  testCases       TestCase[]
  testRuns        TestRun[]
  bugs            Bug[]
  artifacts       Artifact[]
  agentRuns       AgentRun[]
  workflowRuns    WorkflowRun[]
  approvalGates   ApprovalGate[]
  approvalRequests ApprovalRequest[]
  domainEvents    DomainEvent[]
  usageRecords    UsageRecord[]
  routingPolicies RoutingPolicy[]
  mcpGrants       McpGrant[]

  @@index([status, phase])
  @@map("projects")
}

enum RepoRole {
  FRONTEND
  BACKEND
  MOBILE
  INFRA
  SHARED
  DOCS
}

enum VcsProvider {
  GITHUB
  GITLAB
  BITBUCKET
  LOCAL
  MOCK
}

model ProjectRepository {
  id            String      @id @default(uuid())
  projectId     String
  key           String // 'api', 'web'
  role          RepoRole
  provider      VcsProvider @default(GITHUB)
  url           String
  defaultBranch String      @default("main")
  workspacePath String?
  branchPattern String      @default("^(feat|fix|chore)/")
  protectedBranches String[] @default(["main", "master", "develop"])
  codingStandardsRef String?
  config        Json        @default("{}")
  createdAt     DateTime    @default(now())

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  branches     Branch[]
  pullRequests PullRequest[]
  tasks        Task[]

  @@unique([projectId, key])
  @@map("project_repositories")
}

enum IntegrationKind {
  PRODUCT
  BA
  VCS
  DESIGN
  TESTING
  CUSTOM
}

model ProjectIntegration {
  id          String          @id @default(uuid())
  projectId   String
  kind        IntegrationKind
  serverKey   String // mcp_servers.key
  externalRef String? // jira project key, figma file key…
  config      Json            @default("{}")
  enabled     Boolean         @default(true)
  createdAt   DateTime        @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, kind])
  @@map("project_integrations")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 2 — Discovery input
// ═══════════════════════════════════════════════════════════════════════════

enum DocumentKind {
  MEETING_TRANSCRIPT
  MEETING_NOTES
  EMAIL
  SPECIFICATION
  RESEARCH
  CONVERSATION
  OTHER
}

model SourceDocument {
  id           String       @id @default(uuid())
  projectId    String
  kind         DocumentKind
  title        String
  content      String
  contentSha   String
  occurredAt   DateTime?
  participants Json         @default("[]")
  metadata     Json         @default("{}")
  ingestedAt   DateTime?
  createdAt    DateTime     @default(now())

  project Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  chunks  DocumentChunk[]

  @@unique([projectId, contentSha])
  @@index([projectId, kind])
  @@map("source_documents")
}

model DocumentChunk {
  id             String                       @id @default(uuid())
  documentId     String
  ordinal        Int
  content        String
  tokenCount     Int
  startChar      Int
  endChar        Int
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?
  metadata       Json                         @default("{}")
  createdAt      DateTime                     @default(now())

  document SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, ordinal])
  @@map("document_chunks")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 3 — Product (Product Owner Agent output)
// ═══════════════════════════════════════════════════════════════════════════

enum RecordStatus {
  DRAFT
  REVIEW
  APPROVED
  SUPERSEDED
  REJECTED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS_RULE
  CONSTRAINT
}

enum Priority {
  MUST
  SHOULD
  COULD
  WONT
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model ProductVision {
  id                String   @id @default(uuid())
  projectId         String   @unique
  statement         String
  problem           String
  targetUsers       Json     @default("[]")
  valueProposition  String
  successMetrics    Json     @default("[]")
  version           Int      @default(1)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("product_visions")
}

model BusinessGoal {
  id          String   @id @default(uuid())
  projectId   String
  ref         String
  title       String
  description String
  metric      String?
  targetValue String?
  priority    Priority @default(SHOULD)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ref])
  @@map("business_goals")
}

model Stakeholder {
  id        String   @id @default(uuid())
  projectId String
  name      String
  role      String
  interests Json     @default("[]")
  concerns  Json     @default("[]")
  influence String? // HIGH | MEDIUM | LOW
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("stakeholders")
}

model Requirement {
  id              String          @id @default(uuid())
  projectId       String
  ref             String // REQ-014
  type            RequirementType
  priority        Priority        @default(SHOULD)
  statement       String
  rationale       String?
  acceptanceNotes String?
  confidence      Float           @default(0.5)
  status          RecordStatus    @default(DRAFT)
  sourceRefs      Json            @default("[]") // [{documentId, span:[start,end]}]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  project      Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  linksFrom    RequirementLink[]   @relation("LinkFrom")
  linksTo      RequirementLink[]   @relation("LinkTo")
  storyLinks   StoryRequirement[]

  @@unique([projectId, ref])
  @@index([projectId, type, status])
  @@map("requirements")
}

enum RequirementLinkKind {
  DERIVES_FROM
  CONFLICTS_WITH
  DUPLICATES
  REFINES
  DEPENDS_ON
}

model RequirementLink {
  id        String              @id @default(uuid())
  fromId    String
  toId      String
  kind      RequirementLinkKind
  detail    String?
  resolved  Boolean             @default(false)
  createdAt DateTime            @default(now())

  from Requirement @relation("LinkFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Requirement @relation("LinkTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@map("requirement_links")
}

model BusinessRule {
  id        String   @id @default(uuid())
  projectId String
  ref       String
  statement String
  appliesTo String?
  rationale String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ref])
  @@map("business_rules")
}

model Constraint {
  id        String   @id @default(uuid())
  projectId String
  kind      String // TECHNICAL | BUDGET | TIMELINE | REGULATORY | ORGANISATIONAL
  statement String
  impact    String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("constraints")
}

model Assumption {
  id          String   @id @default(uuid())
  projectId   String
  statement   String
  riskIfWrong String?
  confidence  Float    @default(0.5)
  validated   Boolean  @default(false)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("assumptions")
}

model OpenQuestion {
  id         String    @id @default(uuid())
  projectId  String
  question   String
  askedOf    String?
  blocksRefs Json      @default("[]")
  severity   Severity  @default(MEDIUM)
  answer     String?
  answeredAt DateTime?
  createdAt  DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, answeredAt])
  @@map("open_questions")
}

model ProductDecision {
  id          String   @id @default(uuid())
  projectId   String
  ref         String
  title       String
  context     String
  decision    String
  rationale   String
  decidedBy   String?
  decidedAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, ref])
  @@map("product_decisions")
}

model Risk {
  id          String   @id @default(uuid())
  projectId   String
  description String
  likelihood  String
  impact      String
  mitigation  String?
  severity    Severity @default(MEDIUM)
  createdAt   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("risks")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 4 — Backlog (Business Analyst Agent output)
// ═══════════════════════════════════════════════════════════════════════════

model Epic {
  id         String   @id @default(uuid())
  projectId  String
  ref        String // EP-3
  title      String
  goal       String?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stories Story[]

  @@unique([projectId, ref])
  @@map("epics")
}

enum StoryStatus {
  DRAFT
  REVIEW
  CHANGES_REQUESTED
  APPROVED
  PLANNED
  IN_PROGRESS
  IN_REVIEW
  IN_QA
  DONE
  REJECTED
}

enum SizeSignal {
  XS
  S
  M
  L
  XL
}

model Story {
  id                        String      @id @default(uuid())
  projectId                 String
  epicId                    String?
  ref                       String // US-142
  title                     String
  userStory                 String
  businessValue             String
  description               String
  priority                  Priority    @default(SHOULD)
  status                    StoryStatus @default(DRAFT)
  labels                    String[]    @default([])
  sizeSignal                SizeSignal  @default(M)
  functionalRequirements    Json        @default("[]")
  nonFunctionalRequirements Json        @default("[]")
  edgeCases                 Json        @default("[]")
  risks                     Json        @default("[]")
  assumptions               Json        @default("[]")
  businessRules             Json        @default("[]")
  definitionOfReady         Json        @default("[]")
  orderIndex                Int         @default(0)
  createdAt                 DateTime    @default(now())
  updatedAt                 DateTime    @updatedAt

  project            Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  epic               Epic?                @relation(fields: [epicId], references: [id], onDelete: SetNull)
  acceptanceCriteria AcceptanceCriterion[]
  dependenciesFrom   StoryDependency[]    @relation("DepFrom")
  dependenciesTo     StoryDependency[]    @relation("DepTo")
  requirementLinks   StoryRequirement[]
  qualityFlags       StoryQualityFlag[]
  estimates          Estimate[]
  estimateReviews    EstimateReview[]
  tasks              Task[]
  branches           Branch[]
  pullRequests       PullRequest[]
  designReferences   DesignReference[]
  testCases          TestCase[]
  bugs               Bug[]
  workflowRuns       WorkflowRun[]
  usageRecords       UsageRecord[]

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@index([epicId, orderIndex])
  @@map("stories")
}

enum AcceptanceKind {
  GWT
  CHECKLIST
}

model AcceptanceCriterion {
  id         String         @id @default(uuid())
  storyId    String
  ref        String
  kind       AcceptanceKind @default(GWT)
  given      String?
  whenText   String?        @map("when_text")
  thenText   String?        @map("then_text")
  statement  String?
  orderIndex Int            @default(0)
  createdAt  DateTime       @default(now())

  story     Story      @relation(fields: [storyId], references: [id], onDelete: Cascade)
  testCases TestCase[]

  @@unique([storyId, ref])
  @@map("acceptance_criteria")
}

enum StoryDependencyKind {
  BLOCKS
  RELATES
  SPLIT_FROM
  MERGED_INTO
}

model StoryDependency {
  id        String              @id @default(uuid())
  fromId    String
  toId      String
  kind      StoryDependencyKind
  createdAt DateTime            @default(now())

  from Story @relation("DepFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Story @relation("DepTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, kind])
  @@map("story_dependencies")
}

model StoryRequirement {
  storyId       String
  requirementId String

  story       Story       @relation(fields: [storyId], references: [id], onDelete: Cascade)
  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([storyId, requirementId])
  @@map("story_requirements")
}

enum QualityFlagKind {
  DUPLICATE
  AMBIGUOUS
  TOO_LARGE
  MISSING_AC
  TECHNICAL_AS_BUSINESS
  MISSING_EDGE_CASES
  CONFLICTING
  UNTESTABLE
}

model StoryQualityFlag {
  id        String          @id @default(uuid())
  storyId   String
  kind      QualityFlagKind
  detail    String
  severity  Severity        @default(MEDIUM)
  resolved  Boolean         @default(false)
  createdAt DateTime        @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@index([storyId, resolved])
  @@map("story_quality_flags")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 5 — Architecture
// ═══════════════════════════════════════════════════════════════════════════

model ArchitectureOption {
  id                  String   @id @default(uuid())
  projectId           String
  variant             String // 'A' | 'B' | 'C'
  name                String
  overview            String
  diagramMermaid      String?
  components          Json     @default("[]")
  dataFlow            Json     @default("[]")
  apiStrategy         Json     @default("{}")
  databaseStrategy    Json     @default("{}")
  cachingStrategy     Json     @default("{}")
  authentication      Json     @default("{}")
  authorization       Json     @default("{}")
  security            Json     @default("{}")
  scalability         Json     @default("{}")
  observability       Json     @default("{}")
  deployment          Json     @default("{}")
  cicd                Json     @default("{}")
  infrastructure      Json     @default("{}")
  costConsiderations  Json     @default("{}")
  developmentComplexity String?
  operationalComplexity String?
  advantages          Json     @default("[]")
  disadvantages       Json     @default("[]")
  risks               Json     @default("[]")
  migrationStrategy   String?
  agentRunId          String?
  round               Int      @default(1)
  createdAt           DateTime @default(now())

  project        Project                      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun       AgentRun?                    @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  evaluations    ArchitectureEvaluation[]
  recommendations ArchitectureRecommendation[]
  adrs           Adr[]

  @@unique([projectId, variant, round])
  @@map("architecture_options")
}

enum ArchCriterion {
  DEVELOPMENT_SPEED
  COST
  SCALABILITY
  SECURITY
  MAINTAINABILITY
  OPERATIONAL_COMPLEXITY
  TEAM_FIT
  PERFORMANCE
  FUTURE_EXTENSIBILITY
  RISK
}

model ArchitectureEvaluation {
  id         String        @id @default(uuid())
  optionId   String
  criterion  ArchCriterion
  score      Float // 0–10
  weight     Float         @default(1)
  reasoning  String
  agentRunId String? // MUST be an architecture-critic run — asserted in runtime + trigger
  createdAt  DateTime      @default(now())

  option   ArchitectureOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  agentRun AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([optionId, criterion])
  @@map("architecture_evaluations")
}

model ArchitectureRecommendation {
  id                  String   @id @default(uuid())
  projectId           String
  recommendedOptionId String
  reasoning           String
  tradeoffs           Json     @default("[]")
  risks               Json     @default("[]")
  switchConditions    Json     @default("[]")
  scores              Json     @default("{}")
  agentRunId          String?
  createdAt           DateTime @default(now())

  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  recommendedOption ArchitectureOption @relation(fields: [recommendedOptionId], references: [id], onDelete: Cascade)
  agentRun          AgentRun?          @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@map("architecture_recommendations")
}

enum AdrStatus {
  PROPOSED
  APPROVED
  SUPERSEDED
  REJECTED
}

model Adr {
  id                  String    @id @default(uuid())
  projectId           String
  number              Int
  title               String
  status              AdrStatus @default(PROPOSED)
  context             String
  problem             String
  optionsConsidered   Json      @default("[]")
  decision            String
  rationale           String
  consequences        Json      @default("[]")
  risks               Json      @default("[]")
  alternativesRejected Json     @default("[]")
  optionId            String?
  approvedByUserId    String?
  approvedAt          DateTime?
  supersededByAdrId   String?   @unique
  createdAt           DateTime  @default(now())

  project        Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  option         ArchitectureOption? @relation(fields: [optionId], references: [id], onDelete: SetNull)
  approvedBy     User?               @relation("AdrApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  supersededBy   Adr?                @relation("AdrSupersession", fields: [supersededByAdrId], references: [id], onDelete: SetNull)
  supersedes     Adr?                @relation("AdrSupersession")
  pullRequests   PullRequest[]

  @@unique([projectId, number])
  @@map("adrs")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 6 — Estimation & planning
// ═══════════════════════════════════════════════════════════════════════════

enum EstimatorKind {
  PRIMARY
  INDEPENDENT
  HUMAN
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

model Estimate {
  id              String        @id @default(uuid())
  projectId       String
  storyId         String
  estimatorKind   EstimatorKind @default(PRIMARY)
  storyPoints     Float?
  hoursEngineering Float
  hoursFrontend   Float         @default(0)
  hoursBackend    Float         @default(0)
  hoursQa         Float         @default(0)
  hoursDevops     Float         @default(0)
  hoursDesign     Float         @default(0)
  hoursSecurity   Float         @default(0)
  riskBuffer      Float         @default(0)
  confidence      Float // 0–1 — mandatory, never a bare number
  riskLevel       RiskLevel     @default(MEDIUM)
  rangeLowHours   Float
  rangeHighHours  Float
  assumptions     Json          @default("[]")
  drivers         Json          @default("[]")
  agentRunId      String?
  createdAt       DateTime      @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story    Story     @relation(fields: [storyId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)

  @@unique([storyId, estimatorKind])
  @@map("estimates")
}

enum EstimateReviewStatus {
  ACCEPTED
  ESTIMATION_REVIEW_REQUIRED
  RECONCILED
}

model EstimateReview {
  id              String               @id @default(uuid())
  projectId       String
  storyId         String
  primaryHours    Float
  independentHours Float
  variancePct     Float
  status          EstimateReviewStatus
  reconciledHours Float?
  notes           String?
  createdAt       DateTime             @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story   Story   @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId])
  @@map("estimate_reviews")
}

model ResourcePlan {
  id                     String   @id @default(uuid())
  projectId              String
  version                Int      @default(1)
  estimatedDurationWeeks Float
  parallelizationNotes   Json     @default("[]")
  bottlenecks            Json     @default("[]")
  criticalDependencies   Json     @default("[]")
  agentRunId             String?
  createdAt              DateTime @default(now())

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun    AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  allocations ResourceAllocation[]

  @@unique([projectId, version])
  @@map("resource_plans")
}

model ResourceAllocation {
  id            String  @id @default(uuid())
  planId        String
  role          String // BACKEND_DEVELOPER, QA_ENGINEER…
  headcount     Float // 0.25 FTE is valid
  fteAllocation Float
  skills        String[] @default([])
  notes         String?

  plan ResourcePlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@unique([planId, role])
  @@map("resource_allocations")
}

model DeliveryPlan {
  id           String   @id @default(uuid())
  projectId    String
  version      Int      @default(1)
  strategy     String?
  criticalPath Json     @default("[]")
  waves        Json     @default("[]")
  agentRunId   String?
  createdAt    DateTime @default(now())

  project    Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun   AgentRun?   @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  milestones Milestone[]

  @@unique([projectId, version])
  @@map("delivery_plans")
}

model Milestone {
  id         String    @id @default(uuid())
  planId     String
  name       String
  orderIndex Int       @default(0)
  targetDate DateTime?
  storyIds   String[]  @default([])

  plan DeliveryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@map("milestones")
}

enum TaskKind {
  FRONTEND
  BACKEND
  DATABASE
  INFRA
  TEST
  DESIGN
  DOCS
}

model Task {
  id            String   @id @default(uuid())
  storyId       String
  repositoryId  String?
  kind          TaskKind
  title         String
  description   String?
  estimateHours Float?
  orderIndex    Int      @default(0)
  status        String   @default("TODO")
  createdAt     DateTime @default(now())

  story      Story              @relation(fields: [storyId], references: [id], onDelete: Cascade)
  repository ProjectRepository? @relation(fields: [repositoryId], references: [id], onDelete: SetNull)

  @@map("tasks")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 7 — Development
// ═══════════════════════════════════════════════════════════════════════════

model Branch {
  id           String   @id @default(uuid())
  projectId    String
  storyId      String?
  repositoryId String
  name         String
  baseBranch   String   @default("main")
  headSha      String?
  createdAt    DateTime @default(now())

  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story      Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  repository ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  @@unique([repositoryId, name])
  @@map("branches")
}

enum PrState {
  DRAFT
  OPEN
  CHANGES_REQUESTED
  APPROVED
  MERGED
  CLOSED
}

model PullRequest {
  id           String   @id @default(uuid())
  projectId    String
  storyId      String?
  repositoryId String
  adrId        String?
  provider     VcsProvider @default(GITHUB)
  externalId   String?
  number       Int?
  url          String?
  title        String
  body         String
  branchName   String
  baseBranch   String   @default("main")
  state        PrState  @default(OPEN)
  checksState  String?  // PENDING | PASSING | FAILING
  figmaRefs    Json     @default("[]")
  diffStats    Json     @default("{}")
  mergedAt     DateTime?
  agentRunId   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story         Story?            @relation(fields: [storyId], references: [id], onDelete: SetNull)
  repository    ProjectRepository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  adr           Adr?              @relation(fields: [adrId], references: [id], onDelete: SetNull)
  agentRun      AgentRun?         @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  reviews       CodeReview[]
  fixIterations PrFixIteration[]
  testRuns      TestRun[]
  fixedBugs     Bug[]             @relation("BugFixPr")

  @@unique([repositoryId, number])
  @@index([projectId, state])
  @@map("pull_requests")
}

enum ReviewerKind {
  AI
  SECURITY_AI
  HUMAN
}

enum ReviewVerdict {
  APPROVE
  REQUEST_CHANGES
  REJECT
  COMMENT
}

model CodeReview {
  id           String        @id @default(uuid())
  prId         String
  reviewerKind ReviewerKind
  verdict      ReviewVerdict
  summary      String
  agentRunId   String?
  userId       String?
  createdAt    DateTime      @default(now())

  pr       PullRequest     @relation(fields: [prId], references: [id], onDelete: Cascade)
  agentRun AgentRun?       @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  comments ReviewComment[]

  @@index([prId, reviewerKind])
  @@map("code_reviews")
}

model ReviewComment {
  id       String   @id @default(uuid())
  reviewId String
  path     String?
  line     Int?
  severity Severity @default(MEDIUM)
  category String
  body     String
  resolved Boolean  @default(false)

  review CodeReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  @@map("review_comments")
}

model PrFixIteration {
  id           String   @id @default(uuid())
  prId         String
  iteration    Int
  triggeredBy  String // REVIEW | CI | QA
  outcome      String? // FIXED | FAILED | ESCALATED
  agentRunId   String?
  createdAt    DateTime @default(now())

  pr PullRequest @relation(fields: [prId], references: [id], onDelete: Cascade)

  @@unique([prId, iteration])
  @@map("pr_fix_iterations")
}

model DesignReference {
  id           String   @id @default(uuid())
  storyId      String
  figmaFileKey String
  nodeId       String
  name         String
  thumbnailUrl String?
  payload      Json     @default("{}")
  createdAt    DateTime @default(now())

  story Story @relation(fields: [storyId], references: [id], onDelete: Cascade)

  @@unique([storyId, figmaFileKey, nodeId])
  @@map("design_references")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 8 — Quality
// ═══════════════════════════════════════════════════════════════════════════

enum TestType {
  FUNCTIONAL
  REGRESSION
  INTEGRATION
  E2E
  ACCESSIBILITY
  SECURITY
  PERFORMANCE
  NEGATIVE
  EDGE_CASE
  API
  UI
}

enum AutomationStatus {
  NOT_AUTOMATED
  AUTOMATED
  MANUAL_ONLY
  FLAKY
}

model TestCase {
  id                   String           @id @default(uuid())
  projectId            String
  storyId              String?
  acceptanceCriterionId String?
  ref                  String // TC-88
  title                String
  objective            String
  preconditions        Json             @default("[]")
  testData             Json             @default("{}")
  steps                Json             @default("[]")
  expectedResult       String
  priority             Priority         @default(SHOULD)
  type                 TestType
  automationStatus     AutomationStatus @default(NOT_AUTOMATED)
  specPath             String?
  agentRunId           String?
  createdAt            DateTime         @default(now())

  project             Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story               Story?               @relation(fields: [storyId], references: [id], onDelete: SetNull)
  acceptanceCriterion AcceptanceCriterion? @relation(fields: [acceptanceCriterionId], references: [id], onDelete: SetNull)
  agentRun            AgentRun?            @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  results             TestResult[]
  bugs                Bug[]

  @@unique([projectId, ref])
  @@index([projectId, type])
  @@map("test_cases")
}

model TestRun {
  id          String    @id @default(uuid())
  projectId   String
  prId        String?
  trigger     String // STORY_QA | REGRESSION | MANUAL
  commitSha   String?
  environment String    @default("local")
  status      String    @default("RUNNING")
  summary     Json      @default("{}")
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?

  project Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pr      PullRequest? @relation(fields: [prId], references: [id], onDelete: SetNull)
  results TestResult[]

  @@index([projectId, startedAt])
  @@map("test_runs")
}

enum TestStatus {
  PASS
  FAIL
  SKIP
  ERROR
}

model TestResult {
  id             String     @id @default(uuid())
  runId          String
  testCaseId     String
  status         TestStatus
  durationMs     Int?
  failureMessage String?
  stackTrace     String?
  createdAt      DateTime   @default(now())

  run      TestRun        @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase TestCase       @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  evidence TestEvidence[]
  bugs     Bug[]

  @@unique([runId, testCaseId])
  @@map("test_results")
}

enum EvidenceKind {
  SCREENSHOT
  VIDEO
  TRACE
  CONSOLE_LOG
  NETWORK_LOG
  REPORT
}

model TestEvidence {
  id          String       @id @default(uuid())
  resultId    String
  kind        EvidenceKind
  storagePath String
  contentType String?
  sizeBytes   Int?
  createdAt   DateTime     @default(now())

  result TestResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@map("test_evidence")
}

enum BugStatus {
  OPEN
  ANALYSING
  FIXING
  FIXED
  VERIFIED
  WONT_FIX
  ESCALATED
}

model Bug {
  id                String    @id @default(uuid())
  projectId         String
  storyId           String?
  testCaseId        String?
  testResultId      String?
  fixPrId           String?
  ref               String // BUG-12
  title             String
  description       String
  severity          Severity  @default(MEDIUM)
  reproSteps        Json      @default("[]")
  rootCauseAnalysis String?
  status            BugStatus @default(OPEN)
  agentRunId        String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project    Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story      Story?       @relation(fields: [storyId], references: [id], onDelete: SetNull)
  testCase   TestCase?    @relation(fields: [testCaseId], references: [id], onDelete: SetNull)
  testResult TestResult?  @relation(fields: [testResultId], references: [id], onDelete: SetNull)
  fixPr      PullRequest? @relation("BugFixPr", fields: [fixPrId], references: [id], onDelete: SetNull)

  @@unique([projectId, ref])
  @@index([projectId, status])
  @@map("bugs")
}

model QaFixIteration {
  id         String   @id @default(uuid())
  storyId    String
  iteration  Int
  bugRefs    String[] @default([])
  outcome    String?
  agentRunId String?
  createdAt  DateTime @default(now())

  @@unique([storyId, iteration])
  @@map("qa_fix_iterations")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 9 — Artifacts, versioning & lineage
// ═══════════════════════════════════════════════════════════════════════════

enum ArtifactKind {
  REQUIREMENTS
  PRODUCT_VISION
  BACKLOG
  STORY
  ARCHITECTURE_OPTION
  ARCHITECTURE_EVALUATION
  ARCHITECTURE_RECOMMENDATION
  ADR
  ESTIMATE
  RESOURCE_PLAN
  DELIVERY_PLAN
  IMPLEMENTATION_PLAN
  CODE_REVIEW
  SECURITY_REVIEW
  TEST_PLAN
  TEST_CASES
  QA_REPORT
  BUG
  RELEASE_NOTES
}

enum ArtifactScope {
  PROJECT
  STORY
  OPTION
  PR
}

model Artifact {
  id               String        @id @default(uuid())
  projectId        String
  kind             ArtifactKind
  scope            ArtifactScope @default(PROJECT)
  scopeRef         String? // storyId / optionId / prId
  name             String
  currentVersionId String?       @unique
  createdAt        DateTime      @default(now())

  project        Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  versions       ArtifactVersion[] @relation("ArtifactVersions")
  currentVersion ArtifactVersion?  @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  @@unique([projectId, kind, scope, scopeRef])
  @@index([projectId, kind])
  @@map("artifacts")
}

model ArtifactVersion {
  id               String       @id @default(uuid())
  artifactId       String
  version          Int
  contentJson      Json
  contentSha256    String
  status           RecordStatus @default(DRAFT)
  producedByRunId  String?
  approvedByUserId String?
  approvedAt       DateTime?
  qualityWarnings  Json         @default("[]")
  createdAt        DateTime     @default(now())

  artifact         Artifact           @relation("ArtifactVersions", fields: [artifactId], references: [id], onDelete: Cascade)
  currentOf        Artifact?          @relation("CurrentVersion")
  producedByRun    AgentRun?          @relation(fields: [producedByRunId], references: [id], onDelete: SetNull)
  approvedBy       User?              @relation("ArtifactApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  lineageAsChild   ArtifactLineage[]  @relation("LineageChild")
  lineageAsParent  ArtifactLineage[]  @relation("LineageParent")
  approvalRequests ApprovalRequest[]

  @@unique([artifactId, version])
  @@unique([artifactId, contentSha256])
  @@index([artifactId, version(sort: Desc)])
  @@map("artifact_versions")
}

enum LineageRelation {
  DERIVED_FROM
  REVISION_OF
  CRITIQUE_OF
  SUPERSEDES
}

model ArtifactLineage {
  id              String          @id @default(uuid())
  childVersionId  String
  parentVersionId String
  relation        LineageRelation @default(DERIVED_FROM)
  createdAt       DateTime        @default(now())

  child  ArtifactVersion @relation("LineageChild", fields: [childVersionId], references: [id], onDelete: Cascade)
  parent ArtifactVersion @relation("LineageParent", fields: [parentVersionId], references: [id], onDelete: Cascade)

  @@unique([childVersionId, parentVersionId, relation])
  @@map("artifact_lineage")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 10 — Agent execution & audit
// ═══════════════════════════════════════════════════════════════════════════

model AgentDefinition {
  id             String   @id @default(uuid())
  key            String // 'business-analyst'
  version        Int      @default(1)
  name           String
  role           String
  enabled        Boolean  @default(true)
  modelPolicy    Json     @default("{}")
  contextRecipe  String
  permissions    Json     @default("[]")
  writes         String[] @default([])
  inputSchemaRef String
  outputSchemaRef String
  maxRetries     Int      @default(3)
  timeoutSeconds Int      @default(1200)
  budget         Json     @default("{}")
  createdAt      DateTime @default(now())

  runs      AgentRun[]
  mcpGrants McpGrant[]

  @@unique([key, version])
  @@map("agent_definitions")
}

model PromptVersion {
  id        String   @id @default(uuid())
  agentKey  String
  version   String // 'v1'
  path      String
  sha256    String
  body      String
  createdAt DateTime @default(now())

  runs AgentRun[]

  @@unique([agentKey, version])
  @@map("prompt_versions")
}

enum AgentRunStatus {
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
  BUDGET_EXCEEDED
  INVALID_OUTPUT
  PERMISSION_DENIED
}

model AgentRun {
  id              String         @id @default(uuid())
  projectId       String
  agentKey        String
  agentVersion    Int            @default(1)
  agentDefinitionId String?
  promptVersionId String?
  phase           String?
  subjectRef      String? // storyId / optionId
  workflowId      String?
  workflowRunId   String?
  activityId      String?
  attempt         Int            @default(1)
  status          AgentRunStatus @default(RUNNING)
  inputRefs       Json           @default("[]")
  outputVersionId String?
  decisionSummary Json?
  contextSha256   String?
  requestSha256   String?
  error           Json?
  totalCostUsd    Float          @default(0)
  totalTokens     Int            @default(0)
  startedAt       DateTime       @default(now())
  finishedAt      DateTime?
  durationMs      Int?

  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentDefinition AgentDefinition? @relation(fields: [agentDefinitionId], references: [id], onDelete: SetNull)
  promptVersion   PromptVersion?   @relation(fields: [promptVersionId], references: [id], onDelete: SetNull)

  llmCalls        LlmCall[]
  toolCalls       ToolCall[]
  artifactVersions ArtifactVersion[]
  architectureOptions ArchitectureOption[]
  architectureEvaluations ArchitectureEvaluation[]
  architectureRecommendations ArchitectureRecommendation[]
  estimates       Estimate[]
  resourcePlans   ResourcePlan[]
  deliveryPlans   DeliveryPlan[]
  pullRequests    PullRequest[]
  codeReviews     CodeReview[]
  testCases       TestCase[]
  usageRecords    UsageRecord[]

  @@index([projectId, startedAt(sort: Desc)])
  @@index([workflowId])
  @@index([agentKey, status])
  @@map("agent_runs")
}

enum BillingMode {
  API_METERED
  SUBSCRIPTION
  LOCAL_FREE
}

model LlmCall {
  id                String      @id @default(uuid())
  agentRunId        String
  ordinal           Int
  providerKey       String
  modelId           String
  billingMode       BillingMode @default(API_METERED)
  promptTokens      Int         @default(0)
  completionTokens  Int         @default(0)
  cachedReadTokens  Int         @default(0)
  cachedWriteTokens Int         @default(0)
  costUsd           Float       @default(0)
  costUnknown       Boolean     @default(false)
  quotaUnits        Float       @default(0)
  latencyMs         Int         @default(0)
  finishReason      String?
  requestSha256     String?
  fallbackFrom      String?
  createdAt         DateTime    @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, ordinal])
  @@map("llm_calls")
}

enum ToolCallStatus {
  SUCCESS
  FAILED
  DENIED
  TIMEOUT
}

enum PermissionDecision {
  ALLOWED
  DENIED
}

model ToolCall {
  id                 String             @id @default(uuid())
  agentRunId         String
  ordinal            Int
  serverKey          String
  serverRevision     Int?
  toolName           String
  argumentsRedacted  Json               @default("{}")
  resultSummary      String?
  status             ToolCallStatus
  permissionDecision PermissionDecision @default(ALLOWED)
  denyReason         String?
  durationMs         Int                @default(0)
  error              String?
  createdAt          DateTime           @default(now())

  agentRun AgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@unique([agentRunId, ordinal])
  @@index([serverKey, toolName])
  @@map("tool_calls")
}

model UsageRecord {
  id          String      @id @default(uuid())
  projectId   String
  agentRunId  String?
  storyId     String?
  workflowId  String?
  agentKey    String?
  providerKey String
  modelId     String
  billingMode BillingMode
  tokens      Int         @default(0)
  costUsd     Float       @default(0)
  quotaUnits  Float       @default(0)
  localSeconds Int        @default(0)
  occurredAt  DateTime    @default(now())

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentRun AgentRun? @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  story    Story?    @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@index([projectId, occurredAt])
  @@map("usage_records")
}

// ═══════════════════════════════════════════════════════════════════════════
// GROUP 11 — Orchestration, approvals, configuration, events
// ═══════════════════════════════════════════════════════════════════════════

enum WorkflowStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  TERMINATED
  TIMED_OUT
  PARKED
}

model WorkflowRun {
  id               String         @id @default(uuid())
  projectId        String
  storyId          String?
  workflowId       String
  runId            String
  type             String
  status           WorkflowStatus @default(RUNNING)
  parentWorkflowId String?
  workflowVersion  Int            @default(1)
  taskQueue        String
  startedAt        DateTime       @default(now())
  closedAt         DateTime?
  error            Json?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  story   Story?  @relation(fields: [storyId], references: [id], onDelete: SetNull)

  @@unique([workflowId, runId])
  @@index([projectId, status])
  @@map("workflow_runs")
}

enum GateKey {
  BACKLOG
  ARCHITECTURE
  ESTIMATION
  DEV_READINESS
  PR
  QA
  RELEASE
}

model ApprovalGate {
  id           String   @id @default(uuid())
  projectId    String
  key          GateKey
  enabled      Boolean  @default(true)
  requiredRole UserRole
  timeoutHours Int      @default(72)
  autoApprove  Boolean  @default(false)
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@map("approval_gates")
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  EXPIRED
  CANCELLED
}

model ApprovalRequest {
  id                String         @id @default(uuid())
  projectId         String
  gateKey           GateKey
  workflowId        String
  workflowRunId     String?
  signalName        String         @default("approval")
  artifactVersionId String?
  requiredRole      UserRole
  status            ApprovalStatus @default(PENDING)
  title             String
  summary           String?
  context           Json           @default("{}")
  assignedToUserId  String?
  requestedAt       DateTime       @default(now())
  expiresAt         DateTime?
  resolvedAt        DateTime?

  project         Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  artifactVersion ArtifactVersion?  @relation(fields: [artifactVersionId], references: [id], onDelete: SetNull)
  decision        ApprovalDecision?

  @@index([projectId, status])
  @@index([status, expiresAt])
  @@map("approval_requests")
}

enum ApprovalDecisionType {
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

model ApprovalDecision {
  id             String               @id @default(uuid())
  requestId      String               @unique
  userId         String
  decision       ApprovalDecisionType
  comment        String?
  changeRequests Json                 @default("[]")
  decidedAt      DateTime             @default(now())

  request ApprovalRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("approval_decisions")
}

enum ProviderKind {
  API_KEY
  SUBSCRIPTION
  LOCAL
  MOCK
}

model ModelProviderConfig {
  id          String       @id @default(uuid())
  key         String       @unique
  kind        ProviderKind
  billingMode BillingMode
  enabled     Boolean      @default(false)
  baseUrl     String?
  secretRef   String?
  seats       Int          @default(0)
  maxConcurrent Int        @default(4)
  config      Json         @default("{}")
  healthStatus String      @default("UNKNOWN")
  lastHealthCheckAt DateTime?
  updatedAt   DateTime     @updatedAt

  catalog ModelCatalogEntry[]

  @@map("model_providers")
}

enum ModelTier {
  SMALL
  MID
  FRONTIER
}

model ModelCatalogEntry {
  id                    String      @id @default(uuid())
  providerKey           String
  modelId               String
  displayName           String
  tier                  ModelTier
  capabilities          String[]    @default([])
  contextWindow         Int
  maxOutput             Int
  inputCostPer1M        Float?
  outputCostPer1M       Float?
  cachedInputCostPer1M  Float?
  billingMode           BillingMode
  supportsStructuredOutput Boolean  @default(true)
  supportsToolUse       Boolean     @default(true)
  supportsCaching       Boolean     @default(false)
  supportsStreaming     Boolean     @default(true)
  maxConcurrent         Int         @default(4)
  enabled               Boolean     @default(false)
  updatedAt             DateTime    @updatedAt

  provider ModelProviderConfig @relation(fields: [providerKey], references: [key], onDelete: Cascade)

  @@unique([providerKey, modelId])
  @@index([tier, enabled])
  @@map("model_catalog")
}

enum SettingScope {
  GLOBAL
  PROJECT
}

model RoutingPolicy {
  id                String       @id @default(uuid())
  scope             SettingScope @default(GLOBAL)
  projectId         String?
  agentKey          String
  capability        String
  minimumTier       ModelTier    @default(MID)
  preferredProviders String[]    @default([])
  fallbackChain     String[]     @default([])
  effort            String?
  maxCostPerRunUsd  Float?
  allowSubscription Boolean      @default(true)
  updatedAt         DateTime     @updatedAt

  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([scope, projectId, agentKey])
  @@map("routing_policies")
}

enum McpTransport {
  STDIO
  HTTP
  SSE
}

model McpServerConfig {
  id                String       @id @default(uuid())
  key               String       @unique
  name              String
  transport         McpTransport
  command           String?
  args              String[]     @default([])
  url               String?
  env               Json         @default("{}")
  config            Json         @default("{}")
  revision          Int          @default(1)
  enabled           Boolean      @default(false)
  healthStatus      String       @default("UNKNOWN")
  lastHealthCheckAt DateTime?
  updatedAt         DateTime     @updatedAt

  tools  McpToolSchema[]
  grants McpGrant[]

  @@map("mcp_servers")
}

model McpToolSchema {
  id           String   @id @default(uuid())
  serverId     String
  name         String
  description  String?
  inputSchema  Json     @default("{}")
  discoveredAt DateTime @default(now())

  server McpServerConfig @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, name])
  @@map("mcp_tools")
}

model McpGrant {
  id                String   @id @default(uuid())
  agentKey          String
  agentDefinitionId String?
  serverId          String
  projectId         String?
  toolPattern       String   @default("*")
  scopes            String[] @default([])
  argumentPolicy    Json     @default("{}")
  createdAt         DateTime @default(now())

  agentDefinition AgentDefinition? @relation(fields: [agentDefinitionId], references: [id], onDelete: Cascade)
  server          McpServerConfig  @relation(fields: [serverId], references: [id], onDelete: Cascade)
  project         Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([agentKey, serverId, toolPattern, projectId])
  @@map("mcp_grants")
}

model DomainEvent {
  id         String   @id @default(uuid())
  projectId  String
  sequence   BigInt   @default(autoincrement())
  type       String
  payload    Json     @default("{}")
  actor      String // agent:developer | user:<id> | system
  workflowId String?
  agentRunId String?
  occurredAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, sequence])
  @@index([projectId, type])
  @@map("domain_events")
}

model Outbox {
  id          String    @id @default(uuid())
  eventId     String
  topic       String
  payload     Json
  publishedAt DateTime?
  attempts    Int       @default(0)
  createdAt   DateTime  @default(now())

  @@index([publishedAt])
  @@map("outbox")
}

model Setting {
  id              String       @id @default(uuid())
  scope           SettingScope @default(GLOBAL)
  projectId       String?
  key             String
  value           Json
  updatedByUserId String?
  updatedAt       DateTime     @updatedAt

  updatedBy User? @relation(fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([scope, projectId, key])
  @@map("settings")
}

model SecretRecord {
  id          String    @id @default(uuid())
  ref         String    @unique
  provider    String    @default("env")
  description String?
  lastRotated DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@map("secrets")
}
