{
  "name": "ai-sdlc-platform",
  "version": "0.1.0",
  "private": true,
  "description": "AI-Native Software Delivery Organization — Temporal-powered, multi-agent, multi-model, MCP-configurable SDLC platform",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "node infra/scripts/dev.mjs",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "turbo run test:unit",
    "test:workflow": "turbo run test:workflow",
    "test:integration": "turbo run test:integration",
    "test:e2e": "turbo run test:e2e",
    "clean": "turbo run clean && rimraf node_modules",
    "infra:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker/docker-compose.yml logs -f",
    "infra:reset": "docker compose -f infra/docker/docker-compose.yml down -v",
    "db:generate": "pnpm --filter @sdlc/database generate",
    "db:migrate": "pnpm --filter @sdlc/database migrate",
    "db:push": "pnpm --filter @sdlc/database push",
    "db:seed": "pnpm --filter @sdlc/database seed",
    "db:studio": "pnpm --filter @sdlc/database studio",
    "setup": "node infra/scripts/setup.mjs",
    "doctor": "node infra/scripts/doctor.mjs",
    "db:invariants": "pnpm --filter @sdlc/database invariants",
    "worker:dev": "pnpm --filter @sdlc/worker dev",
    "demo": "pnpm --filter @sdlc/worker demo",
    "stop": "node infra/scripts/stop.mjs",
    "api:dev": "pnpm --filter @sdlc/api dev",
    "dashboard:dev": "pnpm --filter @sdlc/dashboard dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "prettier": "^3.4.2",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
